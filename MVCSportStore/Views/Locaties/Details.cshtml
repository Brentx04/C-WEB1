    ViewData["Title"] = "Details";}

<h1>Details</h1>

<div>
    <h4>Locatie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Stad
        </dt>
        <dd class="col-sm-10">
            @Model.Stad
        </dd>
