@model Afdeling

@{
    ViewData["Title"] = "Delete";}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>


<div>
    <h4>Afdeling</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            AfdelingNaam
        </dt>
        <dd class="col-sm-10">
            @Model.AfdelingNaam
        </dd>
        <dt class="col-sm-2">
            Locatie
        </dt>
        <dd class="col-sm-10">
            @Model.Locatie!.Stad
        </dd>
        <dt class="col-sm-2">
            Land
        </dt>
        <dd class="col-sm-10">
            @Model.Locatie!.Land!.LandNaam
        </dd>
    </dl>
</div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="AfdelingId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
