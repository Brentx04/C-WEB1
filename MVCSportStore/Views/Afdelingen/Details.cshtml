@model Afdeling

@{
    ViewData["Title"] = "Details";
    var card = new MVCSportStore.ViewModels.AfdelingCard();
    card.AfdelingNaam = Model.AfdelingNaam;
    card.AfdelingId = Model.AfdelingId;
    card.LandCode = Model.Locatie!.Land!.LandCode;
    card.Locatie = Model.Locatie.Stad;
    card.Land = Model.Locatie.Land.LandNaam;
}

<h1>Details</h1>

<h4>AfdelingCardTagHelper</h4>
<afdeling-card afdeling-card="@card"></afdeling-card>

<h4 class="mt-4">AfdelingCard2TagHelper (TagBuilder)</h4>
<afdeling-card2 card="@card"></afdeling-card2>
<hr />

<div>
    <h4>Afdeling</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            AfdelingNaam
        </dt>
        <dd class="col-sm-10">
            @Model.AfdelingNaam
        </dd>
        <dt class="col-sm-2">
            Locatie
        </dt>
        <dd class="col-sm-10">
            @Model.Locatie!.Stad
        </dd>
        <dt class="col-sm-2">
            Land
        </dt>
        <dd class="col-sm-10">
            @Model.Locatie!.Land!.LandNaam
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.AfdelingId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
