@model IEnumerable<Afdeling>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                AfdelingNaam
            </th>
            <th>
                Locatie
            </th>
            <th>
                Land
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.AfdelingNaam
            </td>
            <td>
                @item.Locatie!.Stad
            </td>
            <td>
                @item.Locatie!.Land!.LandNaam
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AfdelingId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AfdelingId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AfdelingId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
